<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-05-25--0013-dispute-evidence" author="elvsf">

        <preConditions>
            <not>
                <tableExists tableName="dispute_evidence"/>
            </not>
        </preConditions>

        <createTable tableName="dispute_evidence">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true"/>
            </column>

            <column name="dispute_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="text" type="TEXT"/>

            <column name="image_url" type="VARCHAR(500)"/>

            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="dispute_evidence"
                baseColumnNames="dispute_id"
                referencedTableName="dispute"
                referencedColumnNames="id"
                constraintName="fk_dispute_evidence_dispute"/>

        <addForeignKeyConstraint
                baseTableName="dispute_evidence"
                baseColumnNames="user_id"
                referencedTableName="app_user"
                referencedColumnNames="id"
                constraintName="fk_dispute_evidence_user"/>

    </changeSet>

</databaseChangeLog>