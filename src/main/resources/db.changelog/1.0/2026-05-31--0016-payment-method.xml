<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-05-31--0016-payment-method" author="elvsf">
        <createTable tableName="payment_method">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="currency" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="network" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="chain_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="token_contract" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>

            <column name="escrow_contract" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>

            <column name="decimals" type="INT">
                <constraints nullable="false"/>
            </column>

            <column name="min_amount" type="DECIMAL(19,8)">
                <constraints nullable="false"/>
            </column>

            <column name="is_enabled" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

            <column name="sort_order" type="INT" defaultValueNumeric="100">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="payment_method"
                columnNames="currency, network"
                constraintName="uk_payment_method_currency_network"/>
    </changeSet>

</databaseChangeLog>